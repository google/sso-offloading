{
 "name": "SSO Offloading Handler",
 "description": "Handles authentication flows delegated from a trusted application.",
  "version": "0.1.2",
 "manifest_version": 3,
 "permissions": [
  "storage",
  "tabs",
  "webRequest",
  "webRequestBlocking",
  "https://*/*"
 ],
 "host_permissions": [
    "https://*/*" 
  ],
 "externally_connectable": {
  "ids": [
   "abaaiopbfcagdjfghfmbiifjolfnlagf"
  ],
  "matches": [
  "isolated-app://*/*"
  ]
 },
  "background": {
    "service_worker": "service_worker.js",
    "type": "module"
  }
}