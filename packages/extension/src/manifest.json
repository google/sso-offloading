{
  "name": "SSO Offloading Handler",
  "description": "Handles authentication flows delegated from a trusted application.",
  "version": "0.1.5",
  "manifest_version": 3,
  "storage": {
    "managed_schema": "schema.json"
  },
  "permissions": [
    "storage",
    "tabs",
    "webRequest",
    "webRequestBlocking",
    "https://*/*"
  ],
  "host_permissions": [
    "https://*/*"
  ],
  "externally_connectable": {
    "ids": [
      "*"
    ],
    "matches": [
      "isolated-app://*/*"
    ]
  },
  "background": {
    "service_worker": "service_worker.js",
    "type": "module"
  },
  "update_url": "https://clients2.google.com/service/update2/crx"
}
